HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# 本机直接运行 npm run dev 时使用 localhost；Compose 内部会覆盖为 postgres。
POSTGRES_DB=cyber_town
POSTGRES_USER=cyber_town
POSTGRES_PASSWORD=cyber_town_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cyber_town:cyber_town_dev@localhost:5432/cyber_town

# 生产 Compose 与部署脚本使用
CYBER_TOWN_IMAGE=ccr.ccs.tencentyun.com/degenerates/cyber-town:latest
PROXY_NETWORK=cyber-town-proxy

# 第二阶段接入真实模型时启用。不要提交真实密钥。
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL_ID=
# LLM_BASE_URL=https://api.openai.com/v1
#
# # DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
